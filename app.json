{
  "expo": {
    "name": "Datile",
    "slug": "datile",
    "scheme": "datile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#4A90D9",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.21",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Today",
              "label": "Datile 오늘 일정",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "오늘의 일정을 홈 화면에서 확인",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodaySmall",
              "label": "Datile 현재 일정",
              "minWidth": "110dp",
              "minHeight": "48dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "description": "현재 진행 중인 일정을 한눈에 확인",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.younghwa87.datile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "acc3f81d-02d7-46ab-b17d-d25faeebddcc"
      }
    },
    "owner": "younghwa87"
  }
}
